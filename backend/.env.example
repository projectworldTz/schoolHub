APP_NAME="SchoolHub Africa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolhub_africa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=schoolhub_cache

MEMCACHED_HOST=127.0.0.1

# Not used locally (see above — cache/queue/session run on the database
# driver instead). Left configured for when Redis becomes available
# (Docker, Memurai, or a Linux host) — production should use redis for all
# three.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# No local mail catcher installed — mail is logged to storage/logs/laravel.log.
# Switch to smtp (e.g. Mailpit on 127.0.0.1:1025) if you want to see rendered emails.
#
# Production uses Brevo's SMTP relay (transactional email, free up to 300/day):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=<your Brevo account login email>
#   MAIL_PASSWORD=<Brevo SMTP key, NOT your account password — SMTP & API tab>
#   MAIL_FROM_ADDRESS=<a sender verified in Brevo>
# MAIL_FROM_ADDRESS is the one fixed, verified sending address for every
# school on the platform — individual schools don't get their own sending
# domain. What makes mail feel "from" a specific school is the From NAME and
# Reply-To, set per-message in App\Mail\Concerns\BrandsFromSchool, not this
# address itself.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@schoolhub.africa"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Daily encrypted DB backups (spatie/laravel-backup -> Google Cloud Storage).
# BACKUP_DISK lets you point backups at 'local' for a quick test run without
# real GCS credentials; production should leave it unset (defaults to gcs).
# GOOGLE_CLOUD_KEY_FILE must be an ABSOLUTE path to the service-account JSON
# key, stored OUTSIDE the git repo (e.g. /home/projectw/secrets/... on
# Truehost) so it can never be committed.
BACKUP_DISK=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=backups

# AI Assistant (lesson plans, in-app chat) — leave both blank to keep the
# feature disabled; AiAssistantService::isConfigured() checks this and the
# frontend shows a "not configured" state instead of erroring.
#
# Two supported providers — fill in ONE of these, not necessarily both:
#   Anthropic (wins if both are set): key from https://console.anthropic.com/
#   Gemini (free tier, good for testing): key from https://aistudio.google.com/
#     -> click "Get API key" -> "Create API key". No billing required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

VITE_APP_NAME="${APP_NAME}"
