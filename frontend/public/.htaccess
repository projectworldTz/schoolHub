<IfModule mod_mime.c>
  # Truehost's default Apache config doesn't know this extension and falls
  # back to application/octet-stream, which fails strict PWA installability
  # checks (including Chrome's Android app-install/WebAPK logic) even
  # though the file's actual JSON content is valid.
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # index.html/sw.js/the manifest are exactly what the browser (and the
  # service worker's own update check) has to fetch fresh to notice a new
  # deploy at all — a cached copy of either silently disables the in-app
  # "Update available" prompt (see main.tsx) until someone stumbles onto a
  # hard refresh. The hashed /assets/*.js|css files index.html points to
  # don't need this: their filename itself changes whenever their content
  # does, so caching them normally is safe.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS — without this, cookies set by the (HTTPS-only) API get
  # dropped as cross-site by browsers when this SPA is loaded over plain
  # HTTP, since scheme differences make same-registrable-domain requests
  # count as cross-site for SameSite cookie purposes.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA fallback: let real files/dirs (assets, favicon, etc.) serve
  # directly, send every other path to index.html for client-side routing.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
